# Copy to yggdrasil.env, then fill in.
#   cp yggdrasil.example yggdrasil.env
#
# NOTE: values below must be spelled out literally (e.g. DATABASE_URL
# repeats the same password as POSTGRES_PASSWORD) — docker-compose does not
# interpolate ${VAR} across env_file: targets, only from a file literally
# named .env. See docker-compose.yml's header comment.
#
# This single file is passed via env_file: to every service that needs it;
# extra vars a given container doesn't read are harmless.

# ---------------------------------------------------------------------------
# Public hosts — set up matching NPM proxy hosts, see .setup.
# ---------------------------------------------------------------------------
APP_PUBLIC_URL=https://app.yourdomain.example
API_PUBLIC_URL=https://api.yourdomain.example
DOCS_SITE_URL=https://docs.yourdomain.example
# Same value as API_PUBLIC_URL — read by the web app specifically.
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.example

# Base domain for a project's always-on primary deployment
# (<project-slug>.apps.<domain>, ADR 003 §15). Reaching these from outside
# this host is NOT wired up yet in this compose file (the target k3s
# cluster's ingress isn't published) — see .setup's "Project-deployment
# ingress" note. Leave the placeholder for now; revisit once that's wired up.
APPS_BASE_DOMAIN=apps.yourdomain.example

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=yggdrasil
POSTGRES_PASSWORD=
POSTGRES_DB=yggdrasil
# Repeats POSTGRES_USER/PASSWORD/DB above — see NOTE at top of this file.
DATABASE_URL=postgresql://yggdrasil:CHANGE-ME@postgres:5432/yggdrasil

# ---------------------------------------------------------------------------
# MinIO (S3-compatible artifact storage)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=yggdrasil
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=yggdrasil
# Repeat MINIO_ROOT_USER/PASSWORD/BUCKET above — api reads these var names.
S3_ACCESS_KEY=yggdrasil
S3_SECRET_KEY=
S3_BUCKET=yggdrasil

# ---------------------------------------------------------------------------
# Shared secrets between api <-> orchestrator
# ---------------------------------------------------------------------------
# 32 random bytes, base64: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=
# Any random string both services share: openssl rand -hex 32
INTERNAL_API_TOKEN=
# Session cookie signing key: openssl rand -hex 32
SESSION_SECRET=

# ---------------------------------------------------------------------------
# GitHub OAuth App — sign-in only (read:user). Required: this is the only
# sign-in method (ADR 009); without it GET /auth/github returns 503.
# Callback URL when creating the OAuth App: <API_PUBLIC_URL>/auth/github/callback
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# GitHub App — repository access (branches/PRs the Orchestrator opens).
# Optional for sign-in, but required for the Orchestrator to actually do
# anything against your repos. Uncomment once you've created the GitHub App.
# ---------------------------------------------------------------------------
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Orchestrator per-job-kind agent images (ADR 004). Only needed once
# yggdrasil-hq/yggdrasil-agent-images publishes these — see .setup.
# ---------------------------------------------------------------------------
# SPEC_GRILL_IMAGE=ghcr.io/yggdrasil-hq/yggdrasil-agent-images/spec_grill:latest
# FEATURE_BUILD_IMAGE=ghcr.io/yggdrasil-hq/yggdrasil-agent-images/feature_build:latest
# TEST_RUN_IMAGE=ghcr.io/yggdrasil-hq/yggdrasil-agent-images/test_run:latest
