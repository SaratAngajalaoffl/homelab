# Copy to openclaw.env, then fill in a real gateway token and at least one
# model provider key:
#   cp openclaw.example openclaw.env
#   openssl rand -hex 32   # use for OPENCLAW_GATEWAY_TOKEN below

# -----------------------------------------------------------------------------
# Gateway auth
# -----------------------------------------------------------------------------
# Required: the gateway binds on the `edge` network (reachable from any other
# container on it, and from the internet once NPM proxies it), so it refuses
# to start without a real token. Never copy an example/placeholder value in
# here verbatim — the gateway rejects known doc placeholders on purpose.
OPENCLAW_GATEWAY_TOKEN=

# -----------------------------------------------------------------------------
# Model provider API keys (set at least one)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...

# -----------------------------------------------------------------------------
# Channels (only set what you enable — can also be done later via
# `docker compose --profile cli run --rm openclaw-cli channels add ...`)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# -----------------------------------------------------------------------------
# Tools + voice/media (optional)
# -----------------------------------------------------------------------------
# BRAVE_API_KEY=...
# PERPLEXITY_API_KEY=pplx-...
# FIRECRAWL_API_KEY=...
# ELEVENLABS_API_KEY=...
# DEEPGRAM_API_KEY=...
