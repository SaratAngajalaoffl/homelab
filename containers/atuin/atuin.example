# Copy to atuin.env, then fill in a real password and mirror it into
# ATUIN_DB_URI (both services load this same file, same pattern as
# containers/immich/immich.example):
#   cp atuin.example atuin.env
#   openssl rand -hex 24   # use for POSTGRES_PASSWORD below

POSTGRES_USER=atuin
POSTGRES_PASSWORD=
POSTGRES_DB=atuin

# Must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above.
ATUIN_DB_URI=postgres://atuin:@atuin-db/atuin

# Leave "true" only while registering accounts on new machines, then flip to
# "false" and re-run `docker compose up -d` — this server is reachable at a
# public *.yggdrasil.cfd domain via nginx-proxy-manager. See .setup.
ATUIN_OPEN_REGISTRATION=true
