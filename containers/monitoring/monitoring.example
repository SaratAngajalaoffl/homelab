# Copy to monitoring.env (gitignored) next to docker-compose.yml:
#   cp monitoring.example monitoring.env
#
# Grafana reads GF_* and TZ from this file (via env_file on the grafana service only).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
TZ=UTC

# cAdvisor, Promtail, and node-exporter use TZ=UTC in docker-compose.yml; edit there if needed.

# Persistent data lives under:
#   ${HOME}/storage/homelab/homelab-conf/monitoring/
#
# Grafana: docker-compose runs the container as 1000:1000 so the bind-mounted
# grafana dir matches a typical $HOME tree. If your login uid/gid is not 1000,
# change `user:` on the grafana service, or `sudo chown -R 1000:1000 .../grafana`
# to match. Alternative: remove `user:` from compose and
#   sudo chown -R 472:472 .../monitoring/grafana
# (see https://grafana.com/docs/grafana/latest/setup-grafana/installation/docker/).
#
# Prometheus and Loki run as 1000:1000 (same idea as Grafana). If needed:
#   mkdir -p .../monitoring/{prometheus,loki,promtail}
#   sudo chown -R 1000:1000 .../monitoring/prometheus .../monitoring/loki
